// Regras de segurança do Firestore — projeto "DevFest-Campinas".
// Não tem deploy automático (sem Firebase CLI no CI): colar manualmente em
// Firebase Console → Firestore Database → Regras → Publicar, toda vez que
// este arquivo mudar. É a ÚNICA linha de defesa real: o site é estático e
// público (GitHub Pages), a apiKey do Firebase não é segredo, então sem
// regra certa qualquer pessoa com o DevTools aberto escreve, sobrescreve
// ou lê o que quiser direto pelo client.
//
// Coleções do visitante: checkins, talk-feedback, event-feedback, talk-questions, talk-question-votes — mesmo formato pras
// cinco (ver firestore-repository.js): id do documento = "<uid>_<entryKey>",
// sempre CRIADO (nunca editado) pelo client, sempre com `edition` e
// `createdAt` (server timestamp, não confia no relógio do navegador).
// O concurso da sessão (contest-projects, contest-votes) segue o mesmo formato; contest-results é um documento do moderador.
//
// KNOWN_EDITIONS precisa espelhar `KNOWN_EDITIONS` em
// docs/js/data/firebase-config.js — atualizar as duas juntas a cada
// edição nova do evento.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isKnownEdition(edition) {
      return edition in ["2026"];
    }

    function isOwnDoc(docId) {
      // id do documento começa com "<uid>_" — só o dono do uid pode criar o seu.
      return request.auth != null
        && docId.size() > request.auth.uid.size()
        && docId[0:request.auth.uid.size()] == request.auth.uid
        && docId[request.auth.uid.size():request.auth.uid.size() + 1] == "_";
    }

    function hasValidBaseFields() {
      let data = request.resource.data;
      return data.edition is string && isKnownEdition(data.edition)
        && data.entryKey is string && data.entryKey.size() > 0 && data.entryKey.size() < 100
        && data.createdAt == request.time;
    }

    function validRating(value) {
      return value is int && value >= 1 && value <= 5;
    }

    function requiredText(data, field, max) {
      return field in data && data[field] is string && data[field].size() > 0 && data[field].size() < max;
    }

    function optionalText(data, field, max) {
      return !(field in data) || (data[field] is string && data[field].size() < max);
    }

    // Moderadores das perguntas: entram com Google (tablet da sala) e o e-mail precisa estar na lista.
    // PREENCHER com os e-mails dos moderadores antes de ligar as perguntas (lista vazia = ninguém modera).
    // Ativar o provedor Google em Authentication e autorizar o domínio gdgcampinas.github.io no console.
    function isModerator() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['gdgcampinascontato@gmail.com'];
    }

    // Aviso do CONTROLE REMOTO do mural (`mural-control/current`, lista `notices`): na posição i da lista (a lista tem no máximo 5, sem laço nas regras: confere cada posição).
    function noticeOk(list, i) {
      return list.size() <= i || (list[i] is map
        && list[i].keys().hasOnly(['id', 'text', 'kind', 'until'])
        && list[i].id is string && list[i].id.size() > 0 && list[i].id.size() <= 40
        && list[i].text is string && list[i].text.size() > 0 && list[i].text.size() <= 140
        && list[i].kind in ['info', 'alert']
        && list[i].until is number);
    }

    // Aspectos do feedback do evento: ESPELHAR os ids de docs/js/data/event-feedback-form.js.
    function validAspects(data) {
      return 'aspects' in data && data.aspects is map
        && data.aspects.keys().hasOnly(['organizacao', 'local', 'alimentacao', 'conteudo', 'networking', 'comunicacao'])
        && data.aspects.keys().hasAll(['organizacao', 'local', 'alimentacao', 'conteudo', 'networking', 'comunicacao'])
        && validRating(data.aspects.organizacao)
        && validRating(data.aspects.local)
        && validRating(data.aspects.alimentacao)
        && validRating(data.aspects.conteudo)
        && validRating(data.aspects.networking)
        && validRating(data.aspects.comunicacao);
    }

    // Check-in numa palestra: sem campo próprio além da base. A chave é sempre a de uma palestra (formato validTalkKey) e o id
    // é exatamente "<uid>_<chave>": sem isso uma pessoa criaria check-ins e, com eles, avaliações à vontade com chaves inventadas.
    match /checkins/{docId} {
      allow get: if isOwnDoc(docId); // só a própria pessoa lê o próprio check-in
      allow list: if false; // ninguém lê a coleção inteira nem os registros de outra pessoa
      allow create: if isOwnDoc(docId) && idMatchesEntry(docId) && hasValidBaseFields()
        && validTalkKey(request.resource.data.entryKey)
        && request.resource.data.keys().hasOnly(['edition', 'entryKey', 'createdAt']);
      allow update, delete: if false;
    }

    // Feedback de palestra: nota 1-5 e nome (obrigatórios); "o que mais gostou" e "o que melhorar" opcionais.
    // Só quem tem o check-in DAQUELA palestra avalia (o id do check-in é o mesmo id deste documento) e só depois de a palestra
    // acabar (com a trava de horário ligada, `talkEnded`).
    match /talk-feedback/{docId} {
      allow get: if isOwnDoc(docId); // só a própria pessoa lê o próprio feedback
      allow list: if false; // ninguém lê a coleção inteira nem os registros de outra pessoa
      allow create: if isOwnDoc(docId) && idMatchesEntry(docId) && hasValidBaseFields()
        && validTalkKey(request.resource.data.entryKey) && talkEnded(request.resource.data.entryKey)
        && request.resource.data.keys().hasOnly(['edition', 'entryKey', 'createdAt', 'rating', 'name', 'highlight', 'improve'])
        && validRating(request.resource.data.rating)
        && requiredText(request.resource.data, 'name', 80)
        && optionalText(request.resource.data, 'highlight', 400)
        && optionalText(request.resource.data, 'improve', 400)
        && exists(/databases/$(database)/documents/checkins/$(docId));
      allow update, delete: if false;
    }

    // Feedback do evento (fim de dia): nota geral 1-5, os 6 aspectos 1-5, nota 0-10 de indicação e nome (obrigatórios); textos opcionais.
    // Uma avaliação por pessoa: a chave é sempre EVENT_FEEDBACK_KEY (docs/js/features/event-feedback.js, um teste confere).
    match /event-feedback/{docId} {
      allow get: if isOwnDoc(docId); // só a própria pessoa lê o próprio feedback
      allow list: if false; // ninguém lê a coleção inteira nem os registros de outra pessoa
      allow create: if isOwnDoc(docId) && idMatchesEntry(docId) && hasValidBaseFields()
        && request.resource.data.entryKey == 'event-end'
        && request.resource.data.keys().hasOnly(['edition', 'entryKey', 'createdAt', 'rating', 'aspects', 'nps', 'name', 'highlight', 'improve'])
        && validRating(request.resource.data.rating)
        && validAspects(request.resource.data)
        && 'nps' in request.resource.data && request.resource.data.nps is int && request.resource.data.nps >= 0 && request.resource.data.nps <= 10
        && requiredText(request.resource.data, 'name', 80)
        && optionalText(request.resource.data, 'highlight', 400)
        && optionalText(request.resource.data, 'improve', 400);
      allow update, delete: if false;
    }

    // O id do documento precisa ser exatamente "<uid>_<entryKey>": sem isso a mesma pessoa criaria vários
    // documentos com ids diferentes e furaria o limite de perguntas, de votos, de check-ins e de avaliações.
    function idMatchesEntry(docId) {
      return docId == request.auth.uid + '_' + request.resource.data.entryKey;
    }

    // ---- Perguntas ao vivo: janela da palestra ----
    // A chave da palestra é "<início em UTC, ISO>|<trilha>" (ex.: 2026-11-28T12:00:00.000Z|ia). O relógio do
    // servidor (request.time) tem que estar entre o início e o fim dela. Chave inventada não fura nada: cria uma
    // "palestra" que não existe na grade e que nenhuma tela mostra. Nos testes (DevFestIA/tools/questions) as
    // palestras têm horário relativo a agora, então dá pra testar em qualquer dia.
    // ESPELHAR docs/js/data/schedule-builder.js (talkWindows: talkMin = 40): se uma palestra durar mais que isso, mude aqui também.
    function talkDurationMinutes() {
      return 40;
    }

    function validTalkKey(talkKey) {
      return talkKey is string && talkKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z\\|[a-z]{1,20}$');
    }

    function talkStart(talkKey) {
      return timestamp.date(int(talkKey[0:4]), int(talkKey[5:7]), int(talkKey[8:10]))
        + duration.time(int(talkKey[11:13]), int(talkKey[14:16]), 0, 0);
    }

    // TRAVA DE HORÁRIO: false = pergunta e voto em qualquer dia e hora (teste em DEV, antes do evento); true = só do
    // início ao fim da palestra. LIGAR (true) ANTES DO EVENTO, junto com `enforceWindow` de docs/js/data/talk-questions.js
    // (um teste confere que os dois estão iguais). A linha do return tem que ficar como está (os testes trocam o valor).
    function windowEnforced() {
      return false; // TRAVA-DE-HORARIO
    }

    function talkIsLive(talkKey) {
      return validTalkKey(talkKey)
        && (!windowEnforced()
          || (request.time >= talkStart(talkKey)
            && request.time <= talkStart(talkKey) + duration.time(0, talkDurationMinutes(), 0, 0)));
    }

    // A palestra já acabou (avaliar só depois): com a trava de horário desligada (DEV) vale sempre.
    function talkEnded(talkKey) {
      return validTalkKey(talkKey)
        && (!windowEnforced() || request.time > talkStart(talkKey) + duration.time(0, talkDurationMinutes(), 0, 0));
    }

    // Quem fez check-in nessa palestra (o documento do check-in é "<uid>_<talkKey>").
    function hasCheckin(talkKey) {
      return exists(/databases/$(database)/documents/checkins/$(request.auth.uid + '_' + talkKey));
    }

    // Espaço da pergunta: entryKey = "<talkKey>#<1..3>" (número canônico, sem zero à esquerda). ESPELHAR
    // `maxPerPerson` de docs/js/data/talk-questions.js.
    function validQuestionSlot(data) {
      let parts = data.entryKey.split('#');
      return parts.size() == 2 && parts[0] == data.talkKey
        && parts[1].matches('^[1-9][0-9]?$') && int(parts[1]) <= 3;
    }

    // Perguntas ao vivo por palestra. Fila de aprovação: a pergunta nasce "pending"; só o moderador muda o
    // estado (approved, rejected, answered). A plateia NÃO lista as aprovadas (lê o quadro `talk-boards`, um documento
    // por palestra: 1 leitura em vez de uma consulta por celular); cada pessoa lista só as próprias (consulta filtrando
    // uid == a dela) e o moderador lista tudo.
    // Limite de texto: ESPELHAR `maxLength` de docs/js/data/talk-questions.js (280 = "size() < 281").
    match /talk-questions/{docId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null
        && (isModerator() || resource.data.uid == request.auth.uid);
      allow create: if isOwnDoc(docId) && idMatchesEntry(docId) && hasValidBaseFields()
        && request.resource.data.keys().hasOnly(['edition', 'entryKey', 'talkKey', 'uid', 'createdAt', 'text', 'name', 'status'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && validQuestionSlot(request.resource.data)
        && requiredText(request.resource.data, 'text', 281)
        && requiredText(request.resource.data, 'name', 80)
        && talkIsLive(request.resource.data.talkKey)
        && hasCheckin(request.resource.data.talkKey);
      allow update: if isModerator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['approved', 'rejected', 'answered'];
      allow delete: if false;
    }

    // Votos nas perguntas: 1 por pessoa por pergunta (id "<uid>_<id da pergunta>"), sem desfazer. Só em pergunta
    // aprovada, da mesma palestra, com check-in e durante a palestra. Só o moderador lista/conta (o quadro público
    // não traz o placar por padrão, e ninguém baixa os votos de todo mundo).
    match /talk-question-votes/{docId} {
      allow get: if isOwnDoc(docId);
      allow list: if isModerator();
      allow create: if isOwnDoc(docId) && idMatchesEntry(docId) && hasValidBaseFields()
        && request.resource.data.keys().hasOnly(['edition', 'entryKey', 'talkKey', 'createdAt'])
        && talkIsLive(request.resource.data.talkKey)
        && hasCheckin(request.resource.data.talkKey)
        && exists(/databases/$(database)/documents/talk-questions/$(request.resource.data.entryKey))
        && get(/databases/$(database)/documents/talk-questions/$(request.resource.data.entryKey)).data.talkKey == request.resource.data.talkKey
        && get(/databases/$(database)/documents/talk-questions/$(request.resource.data.entryKey)).data.status == 'approved';
      allow update, delete: if false;
    }

    // Quadro público de cada palestra: as perguntas aprovadas na ordem certa, montado e gravado SÓ pelo moderador
    // (features/board-publisher.js) e lido por qualquer pessoa autenticada, por id (a plateia e a TV ouvem UM documento).
    // O id é a chave da palestra. Ninguém lista. Formato: { edition, updatedAt, questions: [{ id, text, name, votes? }] }.
    match /talk-boards/{talkKey} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if isModerator() && validTalkKey(talkKey)
        && request.resource.data.keys().hasOnly(['edition', 'updatedAt', 'questions'])
        && request.resource.data.edition is string && isKnownEdition(request.resource.data.edition)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.questions is list && request.resource.data.questions.size() <= 100;
      allow delete: if false;
    }

    // ---- Concurso da sessão (Coding Jam): projetos, votos e pódio ----
    // Projeto: uma pessoa com check-in cadastra o PRÓPRIO projeto durante a sessão (nome da pessoa e do projeto). O id é
    // "<uid>_<talkKey>": um projeto por check-in, e sem edição (erro de digitação: o moderador apaga e a pessoa cadastra de
    // novo). Lista quem tem check-in naquela sessão (consulta filtrando talkKey) e o moderador. ESPELHAR `maxLength` de
    // docs/js/data/talk-contest.js (80 = "size() < 81").
    match /contest-projects/{docId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && (isModerator() || hasCheckin(resource.data.talkKey));
      allow create: if isOwnDoc(docId) && idMatchesEntry(docId) && hasValidBaseFields()
        && request.resource.data.keys().hasOnly(['edition', 'entryKey', 'talkKey', 'uid', 'createdAt', 'name', 'project'])
        && request.resource.data.talkKey == request.resource.data.entryKey
        && request.resource.data.uid == request.auth.uid
        && requiredText(request.resource.data, 'name', 81)
        && requiredText(request.resource.data, 'project', 81)
        && talkIsLive(request.resource.data.talkKey)
        && hasCheckin(request.resource.data.talkKey);
      allow update: if false;
      allow delete: if isModerator();
    }

    // Voto no projeto: 1 por check-in (o id é o MESMO do check-in, "<uid>_<talkKey>"), sem desfazer. Só em projeto da mesma
    // sessão, nunca no próprio (o projeto de quem vota tem o mesmo id do voto), com check-in e durante a sessão. Só o
    // moderador lista/conta: a plateia nunca vê o placar.
    match /contest-votes/{docId} {
      allow get: if isOwnDoc(docId);
      allow list: if isModerator();
      allow create: if isOwnDoc(docId) && idMatchesEntry(docId) && hasValidBaseFields()
        && request.resource.data.keys().hasOnly(['edition', 'entryKey', 'talkKey', 'projectId', 'createdAt'])
        && request.resource.data.talkKey == request.resource.data.entryKey
        && request.resource.data.projectId is string
        && request.resource.data.projectId != docId
        && talkIsLive(request.resource.data.talkKey)
        && hasCheckin(request.resource.data.talkKey)
        && exists(/databases/$(database)/documents/contest-projects/$(request.resource.data.projectId))
        && get(/databases/$(database)/documents/contest-projects/$(request.resource.data.projectId)).data.talkKey == request.resource.data.talkKey;
      allow update, delete: if false;
    }

    // Pódio da sessão: gravado SÓ pelo moderador, de uma vez, quando decide mostrar o resultado; lido por qualquer pessoa
    // autenticada, por id (a chave da sessão). Ninguém lista. Formato: { edition, updatedAt, podium: [{ place, project, name }] }.
    match /contest-results/{talkKey} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if isModerator() && validTalkKey(talkKey)
        && request.resource.data.keys().hasOnly(['edition', 'updatedAt', 'podium'])
        && request.resource.data.edition is string && isKnownEdition(request.resource.data.edition)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.podium is list && request.resource.data.podium.size() <= 10;
      allow delete: if false;
    }

    // ---- Sorteio ----
    // INTERRUPTOR DO QR QUE MUDA: false = o check-in do sorteio aceita qualquer `code` (teste em DEV, antes do evento);
    // true = só com o código atual ou o anterior de `raffle-session/current` (QR que muda a cada ~60 s, mostrado
    // pela organização no telão). LIGAR (true) ANTES DO EVENTO. A linha do return tem que ficar como está (os testes
    // trocam o valor).
    function raffleRequiresCode() {
      return false; // RAFFLE-CODE
    }

    // INTERRUPTOR "1 INGRESSO = 1 CADASTRO": false = o cadastro no sorteio é um por aparelho (id "<uid>_raffle"), sem
    // exigir ingresso (teste em DEV, antes de haver inscritos); true = um por INGRESSO: o id do cadastro é a chave da
    // inscrição (`registrations/<edição>_<sha256 do e-mail>`, a mesma do cartão "Eu vou!") e ela precisa existir, então
    // 2 celulares (ou 2 contas) com o mesmo e-mail caem no mesmo documento e o segundo é recusado. ESPELHAR `requireTicket`
    // de docs/js/data/raffle-config.js (um teste confere). A linha do return tem que ficar como está.
    function raffleRequiresTicket() {
      return false; // RAFFLE-TICKET
    }

    function raffleEntryIdOk(docId) {
      return raffleRequiresTicket()
        ? (request.auth != null
          && docId.matches('^[0-9]{4}_[0-9a-f]{64}$')
          && docId[0:4] == request.resource.data.edition
          && exists(/databases/$(database)/documents/registrations/$(docId)))
        : (isOwnDoc(docId) && idMatchesEntry(docId));
    }

    // O código do check-in confere com o que o moderador publicou (atual ou anterior, pra quem escaneou na virada).
    // `get` dentro da regra funciona mesmo com a leitura do documento fechada pra plateia (abaixo).
    function raffleCodeOk(data) {
      return !raffleRequiresCode()
        || ('code' in data && data.code is string
          && exists(/databases/$(database)/documents/raffle-session/current)
          && (data.code == get(/databases/$(database)/documents/raffle-session/current).data.code
            || data.code == get(/databases/$(database)/documents/raffle-session/current).data.get('previous', '')));
    }

    // Código atual do QR do sorteio: escrito SÓ pelo moderador (features/raffle-draw.js, a cada ~60 s enquanto o QR
    // está na tela) e NUNCA lido pela plateia: se ela pudesse ler, buscaria o código direto no banco e furaria o QR.
    // Fotos ESCONDIDAS do mural do telão (álbuns do Google Fotos): UM documento por álbum (`mural-hidden/<albumId>`) com a lista de ids das fotos que o moderador tirou do ar.
    // O mural (login anônimo) lê o documento do álbum pelo id; só o moderador grava; ninguém lista nem apaga (voltar ao ar = gravar a lista sem aquele id).
    match /mural-hidden/{albumId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if isModerator() && albumId.matches('^[a-z0-9-]{1,40}$')
        && request.resource.data.keys().hasOnly(['edition', 'updatedAt', 'ids'])
        && request.resource.data.edition is string && isKnownEdition(request.resource.data.edition)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.ids is list && request.resource.data.ids.size() <= 500;
      allow delete: if false;
    }

    // CONTROLE REMOTO do mural do telão (avisos, fixar/pausar, recarregar, emergência): UM documento `mural-control/current`. O mural (login anônimo) só LÊ pelo id, com escuta; só o moderador grava
    // (o app regrava o documento inteiro). Ninguém lista nem apaga. Formato fechado: no máximo 5 avisos de até 140 caracteres, emergência de até 160 caracteres, pausa com cena de até 40.
    match /mural-control/{docId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if isModerator() && docId == 'current'
        && request.resource.data.keys().hasOnly(['edition', 'updatedAt', 'notices', 'emergency', 'hold', 'reload'])
        && request.resource.data.keys().hasAll(['edition', 'updatedAt', 'notices', 'emergency', 'hold', 'reload'])
        && request.resource.data.edition is string && isKnownEdition(request.resource.data.edition)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.notices is list && request.resource.data.notices.size() <= 5
        && noticeOk(request.resource.data.notices, 0) && noticeOk(request.resource.data.notices, 1) && noticeOk(request.resource.data.notices, 2)
        && noticeOk(request.resource.data.notices, 3) && noticeOk(request.resource.data.notices, 4)
        && (request.resource.data.emergency == null || (request.resource.data.emergency is map
          && request.resource.data.emergency.keys().hasOnly(['text', 'since'])
          && request.resource.data.emergency.text is string && request.resource.data.emergency.text.size() > 0 && request.resource.data.emergency.text.size() <= 160
          && request.resource.data.emergency.since is number))
        && (request.resource.data.hold == null || (request.resource.data.hold is map
          && request.resource.data.hold.keys().hasOnly(['sceneId', 'until'])
          && (request.resource.data.hold.sceneId == null || (request.resource.data.hold.sceneId is string && request.resource.data.hold.sceneId.size() <= 40))
          && request.resource.data.hold.until is number))
        && request.resource.data.reload is number;
      allow delete: if false;
    }

    match /raffle-session/{docId} {
      allow get, list: if isModerator();
      allow create, update: if isModerator() && docId == 'current'
        && request.resource.data.keys().hasOnly(['edition', 'code', 'previous', 'updatedAt'])
        && request.resource.data.edition is string && isKnownEdition(request.resource.data.edition)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.code is string && request.resource.data.code.matches('^[A-Z0-9]{6,32}$')
        && (!('previous' in request.resource.data)
          || (request.resource.data.previous is string && request.resource.data.previous.matches('^[A-Z0-9]{6,32}$')));
      allow delete: if false;
    }

    // Check-in do sorteio: prova de presença, mesma forma dos checkins de palestra, chave sempre "raffle". Só
    // dá pra fazer com o QR/link que a organização mostra NO evento (`sorteio.html?checkin=<código>`) — o cadastro
    // (abaixo) exige esse check-in, então não dá pra se cadastrar antes do evento nem sem estar lá. `code` é
    // opcional e só confere com o interruptor `raffleRequiresCode()` ligado.
    match /raffle-checkins/{docId} {
      allow get: if isOwnDoc(docId);
      allow list: if false;
      allow create: if isOwnDoc(docId) && idMatchesEntry(docId) && hasValidBaseFields()
        && request.resource.data.entryKey == 'raffle'
        && request.resource.data.keys().hasOnly(['edition', 'entryKey', 'createdAt', 'code'])
        && (!('code' in request.resource.data) || (request.resource.data.code is string && request.resource.data.code.size() < 41))
        && raffleCodeOk(request.resource.data);
      allow update, delete: if false;
    }

    // Cadastro no sorteio: um registro por pessoa (ou por ingresso, com o interruptor ligado), chave sempre "raffle"
    // (features/raffle-signup.js). Nome e sobrenome obrigatórios, e só quem já tem o check-in do sorteio (acima). Ninguém lista (nem o dono lê a
    // lista de outras pessoas) exceto o moderador, que precisa da lista completa pra girar a roleta.
    match /raffle-entries/{docId} {
      allow get: if isOwnDoc(docId);
      allow list: if isModerator();
      allow create: if raffleEntryIdOk(docId) && hasValidBaseFields()
        && request.resource.data.entryKey == 'raffle'
        && request.resource.data.keys().hasOnly(['edition', 'entryKey', 'createdAt', 'firstName', 'lastName'])
        && requiredText(request.resource.data, 'firstName', 60)
        && requiredText(request.resource.data, 'lastName', 80)
        && exists(/databases/$(database)/documents/raffle-checkins/$(request.auth.uid + '_raffle'));
      allow update, delete: if false;
    }

    // Rodada atual do sorteio: `raffle-state/current` = { edition, round, updatedAt }. "Resetar" no site abre a rodada seguinte
    // (SEM apagar nada): só os sorteios da rodada atual contam. Só o moderador lê e grava, e a rodada só anda de 1 em 1
    // (nunca volta, nunca pula), então uma tela esquecida aberta não consegue desfazer o reset de outra.
    function raffleCurrentRound() {
      return exists(/databases/$(database)/documents/raffle-state/current)
        ? get(/databases/$(database)/documents/raffle-state/current).data.round
        : 1;
    }

    match /raffle-state/{docId} {
      allow get, list: if isModerator();
      allow create: if isModerator() && docId == 'current'
        && request.resource.data.keys().hasOnly(['edition', 'round', 'updatedAt'])
        && request.resource.data.edition is string && isKnownEdition(request.resource.data.edition)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.round == 2; // a rodada 1 é a implícita (sem documento)
      allow update: if isModerator() && docId == 'current'
        && request.resource.data.keys().hasOnly(['edition', 'round', 'updatedAt'])
        && request.resource.data.edition == resource.data.edition
        && request.resource.data.updatedAt == request.time
        && request.resource.data.round == resource.data.round + 1;
      allow delete: if false;
    }

    // Sorteios já feitos (um documento por prêmio): só o moderador cria e lista (features/raffle-draw.js). O id
    // do documento É o id do cadastro sorteado + "_draw" — a mesma pessoa nunca é sorteada 2x porque o create
    // de um documento que já existe é recusado (mesmo truque de dedupe dos checkins), não uma checagem no
    // cliente. `entryId` precisa apontar pra um cadastro real. `status`: nasce "winner"; o moderador só pode
    // mudar pra "absent" (sorteado que não estava na sala: o número do prêmio não é gasto, mas a pessoa NÃO volta
    // pra roleta, porque o documento continua lá). Documentos antigos sem `status` contam como "winner".
    match /raffle-draws/{docId} {
      allow get, list: if isModerator();
      allow create: if isModerator() && hasValidBaseFields()
        && request.resource.data.entryKey == 'draw'
        && docId == (request.resource.data.round == 1
          ? request.resource.data.entryId + '_draw'
          : request.resource.data.entryId + '_r' + string(request.resource.data.round) + '_draw')
        && exists(/databases/$(database)/documents/raffle-entries/$(request.resource.data.entryId))
        && request.resource.data.keys().hasOnly(['edition', 'entryKey', 'createdAt', 'entryId', 'name', 'prize', 'status', 'round'])
        && request.resource.data.status == 'winner'
        && request.resource.data.round is int && request.resource.data.round == raffleCurrentRound()
        && requiredText(request.resource.data, 'entryId', 200)
        && requiredText(request.resource.data, 'name', 140)
        && request.resource.data.prize is int && request.resource.data.prize >= 1 && request.resource.data.prize <= 200;
      allow update: if isModerator()
        && resource.data.get('status', 'winner') == 'winner'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'absent';
      allow delete: if false;
    }

    // Inscritos do Sympla e total público: escritos SÓ pelo job (DevFestIA/tools/sympla-sync)
    // com conta de serviço, que ignora estas regras. O site só consulta por id conhecido
    // (registrations: "<edição>_<sha256 do e-mail>"; event-stats: a edição). Ninguém lista, ninguém grava.
    match /registrations/{docId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    match /event-stats/{docId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Estado interno do job (mapa completo de inscritos): nunca acessível pelo client.
    match /sync-state/{docId} {
      allow read, write: if false;
    }

    // Qualquer outra coleção: nada de leitura nem escrita pelo client.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
